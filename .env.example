# Configure as server secrets, never NEXT_PUBLIC_ variables.
# Use "gemini" for a free Google AI Studio key, "ollama" for local AI,
# or "openai" if API credits are available.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional. Set this for stable quiz tokens across server restarts,
# especially when AI_PROVIDER=ollama.
AI_TOKEN_SECRET=
